{
  "$defs": {
    "AnswerRange": {
      "additionalProperties": false,
      "description": "Exact reviewer-selected text in one original answer field (answer-annotation/v1).\n\n``start``/``end`` are half-open code-point offsets into the field's exact text;\nthe field and document digests make a range recorded against other text stale.",
      "properties": {
        "contract": {
          "const": "answer-annotation/v1",
          "default": "answer-annotation/v1",
          "title": "Contract",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "offset_unit": {
          "const": "code_point",
          "default": "code_point",
          "title": "Offset Unit",
          "type": "string"
        },
        "field_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Field Sha256",
          "type": "string"
        },
        "documents_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Documents Sha256",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "start",
        "end",
        "text",
        "field_sha256",
        "documents_sha256"
      ],
      "title": "AnswerRange",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "source_id",
        "source_hash",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "title": "Selection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reviewer's finding about one selected answer passage (answer-annotation/v1).\n\nAnnotations record only what the reviewer chose to annotate; they never claim\nthe answer was reviewed exhaustively, and an unannotated passage is not\nthereby supported. An omission has no answer range and is recorded as a\n``Defect`` without ``answer_ranges``. ``annotation_id`` is the stable handle\nother records (e.g. a reviewer worksheet) use to link to this annotation.",
  "properties": {
    "contract": {
      "const": "answer-annotation/v1",
      "default": "answer-annotation/v1",
      "title": "Contract",
      "type": "string"
    },
    "annotation_id": {
      "pattern": "^ann:[A-Za-z0-9_-]{1,64}$",
      "title": "Annotation Id",
      "type": "string"
    },
    "answer_range": {
      "$ref": "#/$defs/AnswerRange"
    },
    "disposition": {
      "anyOf": [
        {
          "enum": [
            "supported",
            "defective",
            "cannot_verify",
            "incomplete"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "material": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/Selection"
      },
      "title": "Selections",
      "type": "array"
    }
  },
  "required": [
    "annotation_id",
    "answer_range"
  ],
  "title": "AnswerAnnotation",
  "type": "object"
}
